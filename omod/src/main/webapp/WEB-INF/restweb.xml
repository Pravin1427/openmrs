<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         version="2.5">
    <context-param>
        <param-name>rest.resources</param-name>
        <param-value>
            org.openmrs.module.helloworld.web.resource.HelloWorldMessageResource
        </param-value>
    </context-param>

    <filter>
        <filter-name>HelloWorldAuthFilter</filter-name>
        <filter-class>org.openmrs.module.helloworld.web.filter.HelloWorldAuthFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>HelloWorldAuthFilter</filter-name>
        <url-pattern>/ws/rest/v1/helloworld</url-pattern>
    </filter-mapping>

</web-app>